#!/bin/bash
# sotto CLI (SPEC §5.9). Claude Code adds a plugin's bin/ to the Bash
# tool's PATH, so Claude can run this when the user asks, by voice, for a
# different voice or persona (the voice model cannot change its own):
#
#   sotto voice            list the voices, current one marked
#   sotto voice <name>     set the voice (switches a live session now)
#   sotto persona          list the personas, current one marked
#   sotto persona <name>   set the persona (switches a live session now)
#   sotto status           same as /talk status
#   sotto restart          same as /talk restart (reload the daemon's code)
#   sotto window [mode]    same as /talk window (auto, app or chrome)
#   sotto app              same as /talk app (install and use the desktop app)
#   sotto debug capture on|off|status
#                          record the app mic's raw and uplink audio as WAVs
#                          in <data dir>/debug for 10 minutes at most (off
#                          deletes them; daemon/debugcapture.js)
#
# It reuses scripts/toggle.sh (the /talk handler) with a synthesized hook
# input, so both paths share one implementation. The Bash tool does not get
# CLAUDE_PLUGIN_DATA, so the data dir is found here: the dir whose `active`
# file names this session's inbox socket, else any dir with voice active,
# else one with a running daemon, else $CLAUDE_PLUGIN_DATA / the newest
# sotto data dir. Prints one plain line (`sotto voice` alone: one line per voice
# with what it sounds like); exits 1 on an error.
# Never touches OPENAI_API_KEY. macOS /bin/bash 3.2 compatible.

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink "$SELF")"
  [[ "$LINK" == /* ]] && SELF="$LINK" || SELF="${SELF%/*}/$LINK"
done
ROOT="$(cd "${SELF%/*}/.." && pwd)"

usage() {
  printf 'usage: sotto voice [name] | sotto persona [name] | sotto status | sotto restart | sotto window [auto|app|chrome] | sotto app | sotto debug capture on|off|status\n' >&2
  exit 2
}

case "$1" in
  voice|voices) ARGS="voice${2:+ $2}" ;;
  persona|personas) ARGS="persona${2:+ $2}" ;;
  status)       ARGS="status" ;;
  restart)      ARGS="restart" ;;
  window|windows) ARGS="window${2:+ $2}" ;;
  app)          ARGS="app" ;;
  debug)        [[ "$2" == capture && "$3" =~ ^(on|off|status)$ ]] || usage; ARGS="debug" ;;
  -h|--help|help|"") usage ;;
  *) usage ;;
esac
# Only plain words reach the JSON below.
[[ "$ARGS" =~ ^[A-Za-z0-9\ _-]+$ ]] || { [[ "$1" == persona* ]] && printf 'sotto: unknown persona.\n' || printf 'sotto: unknown voice.\n'; exit 1; }

# --- data dir discovery -----------------------------------------------------------
CANDS=()
[[ -n "$CLAUDE_PLUGIN_DATA" ]] && CANDS+=("${CLAUDE_PLUGIN_DATA%/}")
for d in "$HOME"/.claude/plugins/data/sotto*; do [[ -d "$d" ]] && CANDS+=("$d"); done
[[ -d "$HOME/.sotto" ]] && CANDS+=("$HOME/.sotto")

pid_alive() {
  local pid=""
  [[ -r "$1/daemon.pid" ]] && pid="$(<"$1/daemon.pid")"
  pid="${pid%%[[:space:]]*}"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

D=""; PORT=""
# 1. voice is active for THIS session (Claude Code exports its socket to Bash).
if [[ -n "$CLAUDE_CODE_MESSAGING_SOCKET" ]]; then
  for d in "${CANDS[@]}"; do
    [[ -r "$d/active" ]] || continue
    IFS=$'\t' read -r OWNER APORT _ < "$d/active"
    if [[ "$OWNER" == "$CLAUDE_CODE_MESSAGING_SOCKET" ]]; then D="$d"; PORT="$APORT"; break; fi
  done
fi
# 2. voice is active anywhere.
if [[ -z "$D" ]]; then
  for d in "${CANDS[@]}"; do
    [[ -r "$d/active" ]] || continue
    IFS=$'\t' read -r _ APORT _ < "$d/active"
    D="$d"; PORT="$APORT"; break
  done
fi
# 3. a daemon is running.
if [[ -z "$D" ]]; then
  for d in "${CANDS[@]}"; do
    if pid_alive "$d"; then D="$d"; [[ -r "$d/daemon.port" ]] && PORT="$(<"$d/daemon.port")"; break; fi
  done
fi
# 4. $CLAUDE_PLUGIN_DATA, else the most recently used data dir.
if [[ -z "$D" ]]; then
  if [[ -n "$CLAUDE_PLUGIN_DATA" ]]; then
    D="${CLAUDE_PLUGIN_DATA%/}"
  else
    NEWEST=""
    for d in "${CANDS[@]}"; do
      [[ -d "$d/logs" ]] || continue
      if [[ -z "$NEWEST" || "$d/logs" -nt "$NEWEST/logs" ]]; then NEWEST="$d"; fi
    done
    D="${NEWEST:-$HOME/.sotto}"
  fi
fi
PORT="${PORT%%[[:space:]]*}"

# --- debug capture: a flag file the daemon looks at once a second -----------------
if [[ "$1" == debug ]]; then
  DBG="$D/debug"
  case "$3" in
    on)
      mkdir -p -m 700 "$DBG" && : > "$DBG/capture.on" && chmod 600 "$DBG/capture.on" \
        || { printf 'sotto: ERROR cannot write %s\n' "$DBG"; exit 1; }
      printf 'sotto: debug capture on for 10 minutes: the app mic (raw) and what gpt-live-1 hears go to %s\n' "$DBG" ;;
    off)
      rm -f "$DBG/capture.on"; sleep 2; rm -f "$DBG"/*.wav
      printf 'sotto: debug capture off, recordings deleted.\n' ;;
    status)
      N=0; for f in "$DBG"/*.wav; do [[ -e "$f" ]] && N=$((N + 1)); done
      if [[ -e "$DBG/capture.on" ]]; then S=on; else S=off; fi
      printf 'sotto: debug capture %s, %s recording file(s) in %s\n' "$S" "$N" "$DBG" ;;
  esac
  exit 0
fi

# --- run the /talk handler --------------------------------------------------------
ENVV=(CLAUDE_PLUGIN_DATA="$D" CLAUDE_PLUGIN_ROOT="$ROOT" SOTTO_VIA=cli)
[[ "$PORT" =~ ^[0-9]+$ ]] && ENVV+=(CLAUDE_PLUGIN_OPTION_PORT="$PORT")
# The working directory lets /talk persona find the project's own personas
# (<project>/.claude/sotto-personas) when no voice session names the project.
CWD_J="${PWD//\\/\\\\}"; CWD_J="${CWD_J//\"/\\\"}"; CWD_J="${CWD_J//[$'\001'-$'\037']/}"
OUT="$(printf '{"hook_event_name":"UserPromptExpansion","command_name":"sotto:talk","command_args":"%s","cwd":"%s"}' "$ARGS" "$CWD_J" \
  | env "${ENVV[@]}" /bin/bash "$ROOT/scripts/toggle.sh")"

re='"stopReason":"((\\.|[^"\\])*)"'
if [[ "$OUT" =~ $re ]]; then
  MSG="${BASH_REMATCH[1]}"
  MSG="${MSG//\\\"/\"}"
  MSG="${MSG//\\\//\/}"
  MSG="${MSG//\\\\/\\}"
else
  MSG="sotto: ERROR no answer from the /talk handler."
fi
# `sotto voice` with no name: the list, one voice per line with what it sounds
# like, so Claude can pick one from a spoken description ("something warmer").
voice_info() { # daemon/config.js VOICE_INFO descriptions, pinned by test/daemon/voice-info.test.js
  case "$1" in
    alloy)    printf '%s' "Smooth, clear, even · androgynous · American" ;;
    ash)      printf '%s' "Clear, crisp, steady · masculine · American" ;;
    ballad)   printf '%s' "Warm, easygoing, lightly breathy · masculine · American" ;;
    beacon)   printf '%s' "Clean, crisp, articulate · masculine · Filipino" ;;
    bossa)    printf '%s' "Soft, breathy, gentle · feminine · Brazilian" ;;
    cedar)    printf '%s' "Relaxed, textured, casual · masculine · American" ;;
    cinder)   printf '%s' "Deep, calm, grounded · masculine · Southern US" ;;
    coral)    printf '%s' "Bright, lively, upbeat · feminine · American" ;;
    delta)    printf '%s' "Bright, crisp, friendly · feminine · Southern US" ;;
    echo)     printf '%s' "Smooth, warm, low · masculine · American" ;;
    gleam)    printf '%s' "Cheerful, smooth, warm · feminine · North American" ;;
    marin)    printf '%s' "Bright, clear, polished · feminine · American" ;;
    meridian) printf '%s' "Deep, clear, easygoing · masculine · North American" ;;
    quartz)   printf '%s' "Bright, airy, buoyant · feminine · Australian" ;;
    ripple)   printf '%s' "Smooth, dry, relaxed · masculine · Australian" ;;
    sage)     printf '%s' "Bright, clear, measured · feminine · American" ;;
    shimmer)  printf '%s' "Crisp, smooth, calm · lower, androgynous · American" ;;
    stone)    printf '%s' "Deep, relaxed, grounded · masculine · Irish" ;;
    tempo)    printf '%s' "Easygoing, smooth, low · masculine · Brazilian" ;;
    verse)    printf '%s' "Clear, relaxed, a little gravel · masculine · American" ;;
    vesper)   printf '%s' "Dry, low-key, grounded · masculine · British" ;;
    willow)   printf '%s' "Bright, crisp, warm · feminine · Irish" ;;
  esac
}
re_list='^sotto: voice is ([a-z]+)\. Voices: (.*)\. Change it with /talk voice <name>\.$'
if [[ "$ARGS" == voice && "$MSG" =~ $re_list ]]; then
  CUR="${BASH_REMATCH[1]}"; LIST="${BASH_REMATCH[2]}"
  printf 'sotto: voice is %s. Voices:\n' "$CUR"
  LIST="${LIST// (current)/}"
  for v in ${LIST//,/ }; do
    mark=""; [[ "$v" == "$CUR" ]] && mark=" (current)"
    printf '  %-9s %s%s\n' "$v" "$(voice_info "$v")" "$mark"
  done
  printf 'Change it with sotto voice <name>.\n'
  exit 0
fi
printf '%s\n' "$MSG"
[[ "$MSG" == *"ERROR"* || "$MSG" == *"unknown voice"* || "$MSG" == *"unknown persona"* || "$MSG" == *"usage:"* ]] && exit 1
exit 0
